# -----------------------------------------------------------------------------
# Copy to .env and fill in real values. .env is git-ignored: NEVER commit it.
# -----------------------------------------------------------------------------
APP_NAME="Taylor's Events"
APP_ENV=local                 # local | production
APP_DEBUG=true                # false on presentation day unless demoing errors
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

# Developer metrics bar (request time, query count, memory).
# Visible to admins only, and only when this flag is true.
DEV_TOOLBAR=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taylors_events
DB_USER=taylors_app
DB_PASS=change_me

# Separate database for the in-app test lab (never runs on real data)
DB_TEST_NAME=taylors_events_test

# 64-char hex secrets. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=
TICKET_SIGNING_KEY=

SESSION_LIFETIME_MIN=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
UPLOAD_MAX_MB=5
