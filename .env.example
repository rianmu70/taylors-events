# Copy to .env (scripts/setup.sh does it for you). .env is ignored by git.

APP_NAME="Taylor's Events"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taylors_events
DB_USER=taylors_app
DB_PASS=

# Signs QR tickets. 64 hex characters:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
TICKET_SECRET=

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
