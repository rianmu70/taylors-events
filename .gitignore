# Secrets and machine specific settings
.env
.env.*
!.env.example

# Dependencies (none are needed to run; listed so they can never be committed)
/vendor/
/node_modules/

# Runtime files
/storage/logs/*
/storage/cache/*
/storage/uploads/*
/public/uploads/*
!/storage/**/.gitkeep
*.log

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
